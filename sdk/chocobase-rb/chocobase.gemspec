Gem::Specification.new do |spec|
  spec.name          = "chocobase"
  spec.version       = "0.1.0"
  spec.authors       = ["ChocoBase Team"]
  spec.summary       = "Official Ruby and Rails client library for ChocoBase database platform."
  spec.homepage      = "https://github.com/vinay3254/ChocoBase"
  spec.license       = "MIT"
  spec.files         = Dir["lib/**/*.rb"]
  spec.require_paths = ["lib"]
  spec.required_ruby_version = ">= 2.7.0"
end
